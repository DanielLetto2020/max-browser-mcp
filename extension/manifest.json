{
  "manifest_version": 3,
  "name": "Max Browser",
  "version": "3.0.0",
  "description": "Local MCP browser automation bridge for Chrome (83 tools)",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "debugger",
    "tabGroups",
    "downloads",
    "storage",
    "alarms",
    "cookies",
    "clipboardRead",
    "clipboardWrite",
    "bookmarks",
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dom.js", "fast-dom.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["cursor-motion.js", "visual-indicator.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Max Browser",
    "default_popup": "popup.html"
  },
  "key": ""
}
